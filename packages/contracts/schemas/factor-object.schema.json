{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuanli-invest:schema:factor-object:1.0.0",
  "title": "FactorObject",
  "type": "object",
  "additionalProperties": false,
  "required": ["factor_id", "domain", "hypothesis_ids", "economic_mechanism", "formula_or_reference_algorithm", "canonical_input_fields", "frequency", "lookback", "publication_lag_rule", "expected_direction", "normalization", "neutralization", "known_failure_regimes", "missingness_policy", "reference_implementation", "benchmark_ids", "point_in_time_required"],
  "properties": {
    "factor_id": {"type": "string", "pattern": "^FACTOR-(P|N|XS|XA|XP|V|S|E|CROSS)-[A-Z0-9-]+$"},
    "domain": {"enum": ["P", "N", "XS", "XA", "XP", "V", "S", "E", "CROSS"]},
    "hypothesis_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^HYP-"}},
    "economic_mechanism": {"type": "string", "minLength": 1},
    "formula_or_reference_algorithm": {"type": "string", "minLength": 1},
    "canonical_input_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FIELD-"}},
    "frequency": {"type": "string", "minLength": 1},
    "lookback": {"type": "string", "minLength": 1},
    "publication_lag_rule": {"type": "string", "minLength": 1},
    "expected_direction": {"enum": ["positive", "negative", "non_monotonic", "state_dependent", "unknown"]},
    "normalization": {"type": "string", "minLength": 1},
    "neutralization": {"type": "string", "minLength": 1},
    "known_failure_regimes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missingness_policy": {"type": "string", "minLength": 1},
    "reference_implementation": {"type": "string", "minLength": 1},
    "benchmark_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BENCH-"}},
    "point_in_time_required": {"const": true}
  }
}
