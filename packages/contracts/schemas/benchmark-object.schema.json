{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuanli-invest:schema:benchmark-object:1.0.0",
  "title": "BenchmarkObject",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark_id", "domain", "metric_set", "baseline", "split_method", "point_in_time_policy", "lookahead_prohibited", "multiple_testing_policy", "calibration_requirement", "regime_holdout", "acceptance_threshold", "complexity_penalty"],
  "properties": {
    "benchmark_id": {"type": "string", "pattern": "^BENCH-(P|N|XS|XA|XP|V|S|E|CROSS)-[A-Z0-9-]+-V[0-9]+$"},
    "domain": {"enum": ["P", "N", "XS", "XA", "XP", "V", "S", "E", "CROSS"]},
    "metric_set": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "baseline": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "split_method": {"type": "string", "minLength": 1},
    "point_in_time_policy": {"type": "string", "minLength": 1},
    "lookahead_prohibited": {"const": true},
    "multiple_testing_policy": {"type": "string", "minLength": 1},
    "calibration_requirement": {"type": "string", "minLength": 1},
    "regime_holdout": {"type": "string", "minLength": 1},
    "acceptance_threshold": {"type": "string", "minLength": 1},
    "complexity_penalty": {"type": "string", "minLength": 1}
  }
}
