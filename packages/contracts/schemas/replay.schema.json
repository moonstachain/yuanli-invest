{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuanli-invest:schema:replay:1.0.0",
  "allOf": [
    {"$ref": "urn:yuanli-invest:schema:common:1.0.0#/$defs/base"},
    {
      "type": "object",
      "required": ["narrative_id", "case_name", "t0", "window_start", "window_end", "point_in_time_rule", "horizons", "financial_periods", "failure_case", "lookahead_check", "evidence_ids"],
      "properties": {
        "object_type": {"const": "Replay"},
        "narrative_id": {"type": "string"},
        "case_name": {"type": "string"},
        "t0": {"type": "string", "format": "date"},
        "window_start": {"type": "string", "format": "date"},
        "window_end": {"type": "string", "format": "date"},
        "point_in_time_rule": {"type": "string"},
        "horizons": {"type": "array", "items": {"enum": [20, 60, 120, 250]}, "uniqueItems": true},
        "financial_periods": {"type": "integer", "minimum": 0},
        "failure_case": {"type": "boolean"},
        "lookahead_check": {"enum": ["passed", "partial", "failed"]},
        "evidence_ids": {"$ref": "urn:yuanli-invest:schema:common:1.0.0#/$defs/evidence_ids"},
        "paradigm_snapshot_id": {"type": "string", "minLength": 1},
        "stage_snapshot_id": {"type": "string", "minLength": 1},
        "convexity_profile_id": {"type": "string", "minLength": 1},
        "force_triangle_snapshot_id": {"type": "string", "minLength": 1},
        "force_triangle_mode": {"enum": ["legacy_narrative_only", "pnx_pre_registered", "pnx_reconstructed_partial"]},
        "measurements": {"type": "object"},
        "constituents": {"type": "array", "items": {"type": "object"}},
        "counterevidence": {"type": "array", "items": {"type": "string"}},
        "falsifier": {"type": "string"},
        "fundamental_validation": {"type": "string"},
        "method_limits": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    }
  ],
  "unevaluatedProperties": false
}
