{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuanli-invest:theory-object:v0.1.0",
  "title": "TheoryObject",
  "type": "object",
  "additionalProperties": false,
  "required": ["theory_id", "title", "authors", "year", "source_locator", "source_class", "mechanisms", "pnxs_mapping", "claim_boundary", "evidence_status"],
  "properties": {
    "theory_id": {"type": "string", "pattern": "^THEORY-[A-Z0-9]+-[0-9]{4}-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "year": {"type": "integer", "minimum": 1800, "maximum": 2100},
    "source_locator": {"type": "string", "minLength": 1},
    "source_class": {"enum": ["original_paper", "book", "replication", "survey", "practitioner_claim"]},
    "mechanisms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "pnxs_mapping": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["P", "N", "XS", "XA", "XP", "V", "S", "E", "CROSS"]}},
    "claim_boundary": {"type": "string", "minLength": 1},
    "evidence_status": {"enum": ["primary_source_verified", "replication_supported", "survey_only", "practitioner_claim", "disputed", "deprecated"]}
  }
}
