{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuanli-invest:ymq:capability-run:0.1.0",
  "title": "CapabilityRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "battle_id", "capability_id", "capability_version", "git_sha", "dataset_or_panel_revision", "parameter_contract", "started_at", "completed_at", "artifact_hashes", "runner_identity"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^YMQ-RUN-[A-Z0-9-]+$"},
    "battle_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "capability_version": {"type": "string", "minLength": 1},
    "git_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "dataset_or_panel_revision": {"type": "string", "minLength": 1},
    "source_revisions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "parameter_contract": {"type": "object"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "artifact_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}},
    "runner_identity": {"type": "string", "minLength": 1},
    "baseline_id": {"type": ["string", "null"]},
    "hard_negative_set": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "ablation_set": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "falsifiers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "output_artifact_policy": {"type": "string", "minLength": 1}
  }
}
