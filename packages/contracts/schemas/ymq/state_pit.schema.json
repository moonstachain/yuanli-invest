{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuanli-invest:ymq:state-pit:0.1.0",
  "title": "StatePIT",
  "type": "object",
  "additionalProperties": false,
  "required": ["state_id", "state_type", "as_of", "feature_refs", "method_version", "state_payload", "uncertainty", "unknown_fields"],
  "properties": {
    "state_id": {"type": "string", "pattern": "^YMQ-STATE-[A-Z0-9-]+$"},
    "state_type": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "known_as_of": {"type": "string", "format": "date-time"},
    "feature_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^YMQ-FEAT-"}},
    "method_version": {"type": "string", "minLength": 1},
    "state_payload": {"type": "object"},
    "uncertainty": {"type": "object"},
    "unknown_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "projection_may_strengthen_unknown": {"const": false}
  }
}
