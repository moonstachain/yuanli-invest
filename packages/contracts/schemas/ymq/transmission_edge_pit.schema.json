{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuanli-invest:ymq:transmission-edge-pit:0.1.0",
  "title": "TransmissionEdgePIT",
  "type": "object",
  "additionalProperties": false,
  "required": ["edge_id", "from_state_or_driver", "to_state_or_asset", "as_of", "method", "coefficient_or_effect", "confidence_or_uncertainty", "evidence_refs", "stability_window"],
  "properties": {
    "edge_id": {"type": "string", "pattern": "^YMQ-EDGE-[A-Z0-9-]+$"},
    "from_state_or_driver": {"type": "string", "minLength": 1},
    "to_state_or_asset": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "known_as_of": {"type": "string", "format": "date-time"},
    "method": {"type": "string", "minLength": 1},
    "coefficient_or_effect": {},
    "confidence_or_uncertainty": {"type": "object"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stability_window": {"type": "string", "minLength": 1},
    "permanent_beta_claim": {"const": false}
  }
}
