{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuanli-invest:skill-contract:v0.1.0",
  "title": "SkillContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "capability_id", "runtime_class", "input_schema", "output_schema", "data_requirements", "task_instructions", "prohibited_outputs", "failure_behavior", "version_pin", "investment_action_fields_prohibited"],
  "properties": {
    "skill_id": {"type": "string", "pattern": "^SKILL-(WIND|CODEX|REFQ|GENERIC)-[A-Z0-9-]+-V[0-9]+$"},
    "capability_id": {"type": "string", "pattern": "^CAP-(P|N|XS|XA|XP|V|S|E|CROSS)-[0-9]{3}-[A-Z0-9-]+$"},
    "runtime_class": {"enum": ["wind_ai", "codex", "reference_quant", "generic_agent"]},
    "input_schema": {"type": "string", "minLength": 1},
    "output_schema": {"type": "string", "minLength": 1},
    "data_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "task_instructions": {"type": "string", "minLength": 1},
    "prohibited_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["target_price", "buy_signal", "sell_signal", "recommended_weight", "target_weight", "position_size", "broker_action", "live_execution", "scalar_pnx_score"]}},
    "failure_behavior": {"enum": ["fail_closed", "return_unknown", "return_not_applicable"]},
    "version_pin": {"type": "string", "minLength": 1},
    "investment_action_fields_prohibited": {"const": true}
  }
}
