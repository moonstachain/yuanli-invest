{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuanli-invest:schema:research-capability:1.0.0",
  "title": "ResearchCapability",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_id", "name", "domain", "purpose", "theory_ids", "hypothesis_ids", "factor_ids", "algorithm_ids", "benchmark_ids", "canonical_input_fields", "output_contract", "skill_ids", "reference_implementation", "known_failure_regimes", "maturity_state", "provider_independent", "scalar_pnx_score_prohibited", "investment_action_fields_prohibited"],
  "properties": {
    "capability_id": {"type": "string", "pattern": "^CAP-(P|N|XS|XA|XP|V|S|E|CROSS)-[0-9]{3}-[A-Z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "domain": {"enum": ["P", "N", "XS", "XA", "XP", "V", "S", "E", "CROSS"]},
    "purpose": {"type": "string", "minLength": 1},
    "theory_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^THEORY-"}},
    "hypothesis_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^HYP-"}},
    "factor_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FACTOR-"}},
    "algorithm_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ALG-"}},
    "benchmark_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^BENCH-"}},
    "canonical_input_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FIELD-"}},
    "output_contract": {"type": "string", "minLength": 1},
    "skill_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SKILL-"}},
    "reference_implementation": {"type": "string", "minLength": 1},
    "known_failure_regimes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "maturity_state": {"enum": ["concept", "specified", "implemented", "replicated", "benchmark_passed", "shadow_qualified", "canon", "deprecated"]},
    "provider_independent": {"const": true},
    "scalar_pnx_score_prohibited": {"const": true},
    "investment_action_fields_prohibited": {"const": true}
  },
  "anyOf": [
    {"properties": {"factor_ids": {"minItems": 1}}},
    {"properties": {"algorithm_ids": {"minItems": 1}}}
  ]
}
