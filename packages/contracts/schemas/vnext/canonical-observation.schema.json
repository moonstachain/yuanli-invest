{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:yuanli-invest:schema:vnext-canonical-observation:1.0.0",
  "title":"CanonicalObservation","type":"object","additionalProperties":false,
  "required":["observation_id","field_id","target_id","value","unit","as_of","provider","provenance","pit_status"],
  "properties":{
    "observation_id":{"type":"string","pattern":"^OBS-[A-Z0-9-]+$"},"field_id":{"type":"string","pattern":"^FIELD-"},"target_id":{"type":"string","minLength":1},"value":{},"unit":{"type":"string","minLength":1},"effective_at":{"type":["string","null"],"format":"date-time"},"published_at":{"type":["string","null"],"format":"date-time"},"as_of":{"type":"string","format":"date-time"},"provider":{"type":"string","minLength":1},"provider_locator":{"type":["string","null"]},"provenance":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"revision_state":{"enum":["known","unknown","not_applicable"]},"pit_status":{"enum":["qualified","provisional","unknown","fail_closed"]},"quality_flags":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
