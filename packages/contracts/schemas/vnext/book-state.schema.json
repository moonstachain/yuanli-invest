{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:yuanli-invest:schema:vnext-book-state:1.0.0",
  "title":"BookState",
  "type":"object",
  "additionalProperties":false,
  "required":["book_state_id","schema_version","book_id","portfolio_namespace","as_of","memberships","snapshot","authority"],
  "properties":{
    "book_state_id":{"type":"string","pattern":"^BS-[A-Z0-9-]+$"},
    "schema_version":{"const":"1.0.0"},
    "book_id":{"enum":["BOOK-C","BOOK-R","BOOK-X","BOOK-CASH"]},
    "portfolio_namespace":{"type":"string","minLength":1},
    "as_of":{"type":"string","format":"date-time"},
    "memberships":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["membership_role","effective_from","source_event_ref"],
        "properties":{
          "position_passport_id":{"type":["string","null"]},
          "liquidity_reserve_record":{"type":["string","null"]},
          "membership_role":{"enum":["primary","reserve"]},
          "effective_from":{"type":"string","format":"date-time"},
          "source_event_ref":{"type":"string","minLength":1}
        },
        "oneOf":[
          {"required":["position_passport_id"]},
          {"required":["liquidity_reserve_record"]}
        ]
      }
    },
    "survival_constraint_refs":{"type":"array","items":{"type":"string","minLength":1}},
    "source_snapshot_refs":{"type":"array","items":{"type":"string","minLength":1}},
    "snapshot":{
      "type":"object","additionalProperties":false,
      "required":["append_only","point_in_time"],
      "properties":{"append_only":{"const":true},"point_in_time":{"const":true}}
    },
    "authority":{
      "type":"object","additionalProperties":false,
      "required":["portfolio_weight_authority","execution_authority"],
      "properties":{"portfolio_weight_authority":{"const":false},"execution_authority":{"const":false}}
    }
  }
}
