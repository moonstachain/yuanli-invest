{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuanli-invest:schema:yex0-execution-settlement:0.1.0",
  "title": "ExecutionSettlement",
  "type": "object",
  "additionalProperties": false,
  "required": ["execution_settlement_id","schema_version","execution_intent_id","action_contract_id","stream_id","execution_mode","status","reconciliation","drift","research_outcome_ref","execution_quality","projection_is_truth","authority"],
  "properties": {
    "execution_settlement_id": {"type":"string","pattern":"^XS-[A-Z0-9-]+$"},
    "schema_version": {"const":"0.1.0"},
    "execution_intent_id": {"type":"string","pattern":"^EI-[A-Z0-9-]+$"},
    "action_contract_id": {"type":"string","pattern":"^AC-[A-Z0-9-]+$"},
    "stream_id": {"type":"string","pattern":"^ES-[A-Z0-9-]+$"},
    "execution_mode": {"enum":["shadow","broker_paper"]},
    "status": {"enum":["SETTLED","DRIFTED","FAIL_CLOSED","INDETERMINATE"]},
    "reconciliation": {
      "type":"object","additionalProperties":false,
      "required":["capital_intent","yuanli_execution","execution_engine_oms","broker_custodian"],
      "properties": {
        "capital_intent":{"$ref":"#/$defs/reconEntry"},
        "yuanli_execution":{"$ref":"#/$defs/reconEntry"},
        "execution_engine_oms":{"$ref":"#/$defs/reconEntry"},
        "broker_custodian":{"$ref":"#/$defs/reconEntry"}
      }
    },
    "drift": {
      "type":"object","additionalProperties":false,
      "required":["unknown_external_orders","unexplained_fills","unexplained_position_delta","unexplained_cash_delta"],
      "properties": {
        "unknown_external_orders":{"type":"integer","minimum":0},
        "unexplained_fills":{"type":"integer","minimum":0},
        "unexplained_position_delta":{"type":"number"},
        "unexplained_cash_delta":{"type":"number"}
      }
    },
    "research_outcome_ref": {"type":["string","null"]},
    "execution_quality": {
      "type":"object","additionalProperties":false,
      "required":["classification","notes"],
      "properties": {
        "classification":{"enum":["clean","degraded","failed","unknown"]},
        "notes":{"type":"string"}
      }
    },
    "projection_is_truth": {"const":false},
    "authority": {
      "type":"object","additionalProperties":false,
      "required":["grants_new_capital_authority","grants_new_execution_authority"],
      "properties": {
        "grants_new_capital_authority":{"const":false},
        "grants_new_execution_authority":{"const":false}
      }
    }
  },
  "$defs": {
    "reconEntry": {
      "type":"object","additionalProperties":false,
      "required":["status","observed_ref"],
      "properties": {
        "status":{"enum":["MATCHED","SIMULATED_MATCH","NOT_APPLICABLE","MISMATCH","UNKNOWN"]},
        "observed_ref":{"type":"string","minLength":1}
      }
    }
  }
}
