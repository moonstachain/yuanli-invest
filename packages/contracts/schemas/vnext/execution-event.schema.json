{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuanli-invest:schema:yex0-execution-event:0.1.0",
  "title": "ExecutionEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id","schema_version","stream_id","sequence","execution_intent_id","action_contract_id","idempotency_key","event_type","occurred_at","recorded_at","payload","previous_event_hash","event_hash","append_only"],
  "properties": {
    "event_id": {"type":"string","pattern":"^EE-[A-Z0-9-]+$"},
    "schema_version": {"const":"0.1.0"},
    "stream_id": {"type":"string","pattern":"^ES-[A-Z0-9-]+$"},
    "sequence": {"type":"integer","minimum":1},
    "execution_intent_id": {"type":"string","pattern":"^EI-[A-Z0-9-]+$"},
    "action_contract_id": {"type":"string","pattern":"^AC-[A-Z0-9-]+$"},
    "idempotency_key": {"type":"string","minLength":8},
    "event_type": {"enum":["IntentCreated","CapitalAdmissionObserved","ActionContractGranted","FirewallPassed","PlanCreated","OrderSubmitted","OrderAccepted","PartialFillReceived","FillReceived","PositionObserved","AccountObserved","ReconciliationMatched","ExecutionFailureObserved","SettlementClosed"]},
    "occurred_at": {"type":"string","format":"date-time"},
    "recorded_at": {"type":"string","format":"date-time"},
    "payload": {"type":"object"},
    "previous_event_hash": {"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},
    "event_hash": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "append_only": {"const":true}
  }
}
