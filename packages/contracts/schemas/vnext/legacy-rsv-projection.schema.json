{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:yuanli-invest:schema:vnext-legacy-rsv-projection:1.0.0",
  "title":"LegacyRSVProjection",
  "type":"object",
  "additionalProperties":false,
  "required":["legacy_projection_id","schema_version","source_rsv_id","target_ref","primitive_state_refs","engine_assignment","projection_authority"],
  "properties":{
    "legacy_projection_id":{"type":"string","pattern":"^LRP-[A-Z0-9-]+$"},
    "schema_version":{"const":"1.0.0"},
    "source_rsv_id":{"type":"string","minLength":1},
    "target_ref":{"type":"string","minLength":1},
    "primitive_state_refs":{
      "type":"object","additionalProperties":false,
      "required":["P","Xs","N","V","Xa","Xp","S"],
      "properties":{
        "P":{"type":"string"},"Xs":{"type":"string"},"N":{"type":"string"},"V":{"type":"string"},"Xa":{"type":"string"},"Xp":{"type":"string"},"S":{"type":"string"}
      }
    },
    "legacy_force_projection":{"type":["string","null"]},
    "migration_confidence":{"type":"string"},
    "migration_warnings":{"type":"array","items":{"type":"string","minLength":1}},
    "engine_assignment":{
      "type":"object","additionalProperties":false,
      "required":["status"],
      "properties":{
        "status":{"enum":["unresolved","candidate_C","candidate_R","candidate_X","candidate_other","human_review_required","resolved"]},
        "candidate_engine":{"type":["string","null"]},
        "governed_decision_ref":{"type":["string","null"]}
      }
    },
    "auto_engine_thesis_creation_authorized":{"const":false},
    "projection_authority":{
      "type":"object","additionalProperties":false,
      "required":["thesis_authority","future_write_authority"],
      "properties":{"thesis_authority":{"const":false},"future_write_authority":{"const":false}}
    }
  }
}
