{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuanli-invest:q0:agent-run-artifact:1.0.0",
  "title": "AgentRunArtifactCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "agent_name",
    "subject_id",
    "as_of",
    "runtime_profile",
    "input_manifest_hash",
    "tool_calls",
    "claims",
    "counterclaims",
    "unknowns",
    "lookahead_check",
    "prohibited_action_check",
    "trace_id",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0-q0"},
    "run_id": {"type": "string", "minLength": 1},
    "agent_name": {"enum": ["ForceCIOAgent", "ParadigmAgent", "NarrativeAgent", "ConvexityAgent", "FundamentalAgent", "RedTeamAgent", "EvidenceJudgeAgent"]},
    "subject_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "runtime_profile": {"type": "string", "minLength": 1},
    "input_manifest_hash": {"type": "string", "minLength": 1},
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_name", "arguments_hash", "approval_state", "result_hash"],
        "properties": {
          "tool_name": {"type": "string"},
          "arguments_hash": {"type": "string"},
          "approval_state": {"enum": ["not_required", "approved", "rejected", "pending"]},
          "result_hash": {"type": ["string", "null"]}
        }
      }
    },
    "claims": {"$ref": "#/$defs/claim_list"},
    "counterclaims": {"$ref": "#/$defs/claim_list"},
    "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "lookahead_check": {"enum": ["passed", "failed", "not_run"]},
    "prohibited_action_check": {"enum": ["passed", "failed"]},
    "trace_id": {"type": ["string", "null"]},
    "status": {"enum": ["completed", "partial", "blocked", "failed", "waiting_human_approval"]},
    "final_output_artifact_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "claim_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "dimension", "text", "evidence_ids", "confidence", "falsifier"],
        "properties": {
          "claim_id": {"type": "string"},
          "dimension": {"enum": ["P", "N", "X_RIGHT", "X_LEFT", "FUNDAMENTAL", "SURVIVAL", "META"]},
          "text": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "confidence": {"enum": ["high", "medium", "low", "unknown"]},
          "falsifier": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
