{
  "schema_version": "0.1.0",
  "stage": "R2_3B0_CAPABILITY_CONTRACT_ARCHITECTURE_FREEZE",
  "contract_name": "Universal ResearchCapability Contract Architecture",
  "status": "candidate",
  "base_os_model": "one_core_three_worlds_three_gates_one_loop",
  "human_navigation": "势信极_真价生",
  "required_blocks": [
    "identity",
    "scope_routing",
    "theory_causal_mechanism",
    "evidence",
    "input",
    "inference",
    "output",
    "falsification_failure",
    "benchmark_qualification",
    "settlement_learning",
    "runtime_receipt_governance"
  ],
  "identity": {
    "required_fields": ["capability_id", "name", "contract_version", "stable_question", "semantic_parent", "maturity_state", "owner_scope"],
    "stable_question_is_identity": true
  },
  "scope_routing": {
    "required_fields": ["asset_forms", "pricing_archetypes", "authority_levels", "router_dependencies"],
    "asset_form_is_not_pricing_model": true,
    "A0": "asset_form",
    "A1": "pricing_archetype",
    "authority_ladder": ["L0", "L1", "L2", "L3", "L4"]
  },
  "theory_causal_mechanism": {
    "required_fields": ["theory_ids", "hypothesis_ids", "causal_mechanism", "assumptions", "competing_mechanisms", "claim_boundary"],
    "practitioner_claim_self_promotes_to_theory": false
  },
  "evidence": {
    "required_fields": ["evidence_policy", "minimum_evidence_authority", "claim_types", "source_requirements", "as_of_required", "point_in_time_required", "evidence_cutoff_required", "falsifier_required"],
    "claim_types": ["event_fact", "mechanism_hypothesis", "expectation_interpretation", "asset_attribution"],
    "as_of_required": true,
    "point_in_time_required": true,
    "evidence_cutoff_required": true,
    "falsifier_required": true,
    "law": "Claim Authority <= Evidence Authority"
  },
  "input": {
    "required_fields": ["canonical_input_fields", "economic_definitions", "units", "frequency", "publication_lag", "revision_semantics", "missingness_policy", "allowed_transformations"],
    "provider_independent_identity": true,
    "provider_mapping_separate_from_economic_definition": true
  },
  "inference": {
    "required_fields": ["algorithm_families", "identification_assumptions", "state_transition_logic", "uncertainty_representation", "simpler_baselines", "known_failure_modes"],
    "correlation_is_causality": false,
    "feature_importance_is_causality": false,
    "granger_lead_is_causality": false
  },
  "output": {
    "canonical_root": "ResearchState",
    "required_fields": ["state_type", "state_dimensions", "uncertainty_semantics", "evidence_refs", "as_of", "degrade_state", "downstream_dependencies"],
    "optional_typed_fields": ["direction", "magnitude_band", "persistence_band", "confidence_semantics"],
    "scalar_master_score_prohibited": true,
    "prohibited_outputs": ["target_price", "canonical_upside_percentage", "recommended_portfolio_weight", "position_size", "buy_sell_hold", "live_execution_instruction", "weighted_PNXEVSR_composite_score"]
  },
  "falsification_failure": {
    "required_fields": ["falsification_rules", "revision_triggers", "known_failure_regimes", "degrade_behavior", "fail_closed_states"],
    "fail_closed_states": ["insufficient_evidence", "research_only", "stale", "unsupported"]
  },
  "benchmark_qualification": {
    "required_fields": ["simpler_baselines", "point_in_time_split_policy", "oos_policy", "regime_holdout", "false_alarm_accounting", "calibration_requirement", "multiple_testing_policy", "complexity_penalty", "failure_receipts"],
    "lookahead_prohibited": true,
    "complexity_without_incremental_information_is_demoted": true
  },
  "settlement_learning": {
    "required_fields": ["settlement_horizon", "settlement_observables", "settlement_rule", "replay_policy", "revision_rule"],
    "outcome_leakage_prohibited": true,
    "point_in_time_replay_required": true
  },
  "runtime_receipt_governance": {
    "invocation_envelope_required": true,
    "invocation_envelope_fields": ["canon_revision", "canon_hash", "capability_id", "capability_contract_version", "research_target", "A0_asset_form", "A1_pricing_archetype", "as_of", "evidence_cutoff", "provider_runtime"],
    "research_receipt_required": true,
    "research_receipt_fields": ["invocation_envelope", "algorithm_family", "evidence_refs", "output_state_version", "degrade_state"],
    "research_pass_implies_capital_pass": false,
    "capability_acceptance_implies_promotion": false,
    "promotion_implies_evidence_admission": false,
    "execution_authority": "none"
  },
  "n02_reunderwrite_policy": {
    "typed_sla_required": true,
    "universal_latency_value_frozen": false,
    "on_latency_breach": ["research_only", "stale"],
    "required_reunderwrite_modules": ["V", "Xa", "Xp"]
  },
  "human_gate_token": "ACCEPT_R2_3B0_CAPABILITY_CONTRACT_ARCHITECTURE_FREEZE"
}
